PORT=4000
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173

# Configuracion local. No usar credenciales reales en archivos versionados.
DATABASE_URL="postgresql://marisol_app:change-me-local-only@127.0.0.1:5432/proyecto_marisol"
DB_SSL=false
AUTH_SECRET=replace-with-at-least-32-random-characters
MAIL_FROM=noreply@mariovillalonga.website
RESEND_API_KEY=

# Provisioning inicial opcional. Deshabilitar luego de crear el primer admin.
SEED_DEFAULT_ADMIN=true
ADMIN_EMAIL=admin@marisol.com
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_NAME=Administrador
